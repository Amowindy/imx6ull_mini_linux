# i.MX6ULL Mini (NAND) 板级配置（无模块版）
#
# 基准: imx_v7_defconfig -> 只保留 i.MX6ULL 与本板实际外设
# 硬件: DDR3L 256MiB, NAND 512MiB, ENET2 RTL8201F, 7 寸 RGB LCD,
#       TF 卡, USB OTG/HOST, CAN1, UART3(RS232/485/GPS), I2C2(ATK),
#       LED, 蜂鸣器, KEY0
#
# 关键 (2026-11-07):
#   CONFIG_MODULES=n，全部驱动 built-in，不生成 .ko
#   CONFIG_ARCH_FORCE_MAX_ORDER=10：i.MX6ULL 无 IPU/VPU/GPU，不需要
#       imx_v7 的 13；降到 10 后 pageblock=4MiB，CMA 16MiB 不再被
#       向上取整到 32MiB（否则 imx_v7 的 13 会让 CMA 最小 32MiB）
#   CONFIG_CMA_SIZE_MBYTES=16
#   启用: KEXEC、CGROUPS/NAMESPACES（systemd）、nftables、USB_GADGET、
#         iptables、Dynamic Debug/KPROBES
#   关闭: CRASH_DUMP/FTRACE、PM_DEBUG/PM_TEST_SUSPEND、USER_NS、
#         CRYPTO_TLS/AUTHENC、SAHARA/CAAM SECVIO
#   保留: NETFILTER/iptables、IPv6、NFS、USB storage、JFFS2、FB_MXC、
#         MTD_UBI_BLOCK、CPU governors、VLAN、FAT16
#
# 与 U-Boot 的 NAND_PARTITION_LAYOUT 一致:
#   boot(8m),env(4m),logo(8m),kernel(32m),dtb(16m),tee(4m),-(rootfs)
