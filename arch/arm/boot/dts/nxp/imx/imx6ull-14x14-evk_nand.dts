// SPDX-License-Identifier: (GPL-2.0 OR MIT)
//
// i.MX6ULL Mini (NAND) 板级设备树
//
// 依据 IMX6ULL_MINI_V2.2(Mini底板原理图).pdf 核对（2026-11-10）。
// 不再继承 NXP EVK 的 imx6ul-14x14-evk.dtsi，只描述本板实际存在的硬件：
//
//   - DDR3L 256MiB（U-Boot 启动日志 DRAM: 256 MiB），起始 0x80000000
//   - 4.3 寸 RGB888 LCD，800x480@60Hz / 31MHz 像素时钟（ATK4384，屏 ID 0x04）
//       LCD 40pin 接口 J10：
//         pin40 RESET   整板复位网络（核心板 A40，与 MCU 共用复位按键）
//         pin39 CT_INT  触摸中断，10K 上拉 → GPIO1_IO09（核心板 B15）
//         pin38/36      I2C2_SCL / I2C2_SDA（核心板 B31/B32 = UART5_TXD/RXD）
//         pin35 CT_RST  触摸复位，10K 上拉 → SNVS_TAMPER9 = GPIO5_IO09（A48）
//         pin34 BLT_PWM 背光 → GPIO1_IO08（核心板 B16 / PWM1_OUT）
//         LCD 电源由底板 DCDC_3V3 直接提供（不可控，用 fixed regulator 描述）
//   - 电容触摸屏（GT9xx 系列，挂在 I2C2，与摄像头共用总线）
//   - 单网口 ENET2，RTL8201F PHY（MDIO 地址 1，SNVS_TAMPER8 / GPIO5_IO08 复位）
//   - GPMI NAND 512MiB，分区与 U-Boot 的 NAND_PARTITION_LAYOUT 一致
//   - TF 卡（USDHC1，CD = UART1_RTS_B / GPIO1_IO19）
//   - USB OTG（OTG1，Type-C，兼 USB 转串口 CH340）+ USB HOST（OTG2）
//   - CAN1（UART3_RTS_B/CTS_B 复用）、UART3（RS232/RS485/GPS 跳线选择）
//   - 红色状态 LED（GPIO1_IO03，低有效）、有源蜂鸣器（SNVS_TAMPER1 / GPIO5_IO01）、
//     KEY0（UART1_CTS_B / GPIO1_IO18，低有效）
//   - OV5640 摄像头（CSI 并行 DVP 8-bit，P1 18pin 接口，I2C2 地址 0x3C）
//   - PXP 硬件色彩转换/缩放
//   - ON_OFF 按键（核心板 B4，snvs_pwrkey，短按唤醒/长按下电）
//   - SNVS RTC + CR1220 后备电池（核心板 BAT54C 双电源切换，断电保时）
//   - CMA 16MiB（本文件 reserved-memory/linux,cma 声明，见下方注释）
//
// 明确不包含（本板没有或暂未启用）：
//   WM8960 音频（板载无 codec，音频走 USB 声卡，接 USB HOST 口）、
//   AP3216C/ICM20608、SDIO WiFi、QSPI、USDHC2、74HC595 GPIO 扩展、
//   电阻触摸屏（SP_TX 相关 R65/R66 为 DNP）、
//   I2C1/UART2（仅在排针引出，无板载器件，保持 disabled）、
//   snvs_poweroff（本板为分立 DCDC、无 PMIC，启用只会 halt 不会断电）。
//
// 生成的 dtb 名为 imx6ull-14x14-evk_nand.dtb，与 U-Boot 的
// dtb_file / tftp_update 下载文件名一致。

/dts-v1/;

#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/media/video-interfaces.h>
#include "imx6ull.dtsi"

#define NAND_ROOTFS_SIZE 0x1b800000	/* 440MiB = 512MiB - 72MiB 前置分区 */

/ {
	model = "i.MX6ULL Mini NAND Board";
	compatible = "fsl,imx6ull-14x14-evk", "fsl,imx6ull";

	aliases {
		ethernet0 = &fec2;
		mmc0 = &usdhc1;
	};

	chosen {
		stdout-path = &uart1;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;	/* 256MiB */
	};

	/*
	 * CMA（连续内存分配器）：摄像头 CSI / PXP / 显示用的 DMA 缓冲都从这里
	 * 分配，因为这几路外设没有 IOMMU，必须物理连续内存。
	 *
	 * 这里显式声明 16MiB，**CMA 大小以设备树为准**（DTS 有本节点时，
	 * 内核配置 CONFIG_CMA_SIZE_MBYTES 的值被忽略），因此 defconfig 里
	 * 不再显式写 CMA_SIZE_MBYTES，避免"两处配置、不知道谁生效"。
	 *
	 * 16MiB 实测够用：CmaFree 长期有 13MiB 以上剩余，够 640x480 UYVY
	 * （600KiB/帧）与 800x480 XR24（1.5MiB/帧）各自多缓冲；
	 * 也够后续 V4L2_MEMORY_DMABUF 零拷贝共享缓冲。
	 * 注意 256MiB 内存下 16MiB 占 6.25%，是合理比例。
	 *
	 * 实测 CMA **不是**帧率瓶颈（瓶颈是 CPU memcpy，见文档 7.8 节），
	 * 加大 CMA 不会提升帧率。
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x1000000>;	/* 16MiB */
			linux,cma-default;
		};
	};

	/*
	 * 触摸/屏模组的 3.3V 供电：底板 DCDC_3V3 直连，没有可控 GPIO，
	 * 因此用 always-on fixed regulator 描述，供 goodix 的
	 * AVDD28 / VDDIO 引用（驱动对这两个 supply 是强依赖）。
	 */
	reg_touch_3v3: regulator-touch-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "touch-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * 摄像头模块（P1）供电：底板 DCDC_3V3 直连，不可控。
	 * OV5640 模组内部自带 LDO，把 3.3V 转成 AVDD(2.8V)/DVDD(1.5V)/
	 * DOVDD(1.8V)，所以对外只有一个 3.3V 输入，三路 supply 指向同一个
	 * 电源域即可（mainline 的 stm32mp157c-ev1 也是三路同源）。
	 *
	 * ov5640.c 只用 regulator_bulk_enable/disable，不调用
	 * regulator_set_voltage，所以 regulator-fixed 足够。
	 * 不写这三路 supply 时驱动会拿到 dummy regulator 并打印
	 * "supply AVDD not found, using dummy regulator" 警告，功能不受影响，
	 * 但 AVDD/DVDD 在 binding 里是 required，按规范应显式提供。
	 */
	reg_cam_3v3: regulator-cam-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "cam-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* LCD 模组供电：底板 DCDC_3V3 直连（40pin 接口 pin1/2），不可控 */
	reg_lcd_3v3: regulator-lcd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "lcd-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * 背光（PWM1，周期 5ms = 200Hz）。
	 *
	 * brightness-levels 的值本身就是占空比（scale = 最后一项 = 255），
	 * default-brightness-level 是数组下标。原来的
	 * <0 4 8 16 32 64 128 255> 只有 8 档，50% 之后直接跳到 100%，
	 * 中间没有可调空间。这里改为两点 + num-interpolated-steps 线性插值：
	 *   生成 (2-1)*255+1 = 256 档，max_brightness = 255
	 *   于是 brightness(0..255) 直接等于占空比百分比 * 2.55
	 * 默认 204 = 255*80% ≈ 80% 占空比，与 U-Boot 的 PWM 占空比保持一致。
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 5000000 0>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <204>;
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_led>;

		led0 {
			label = "sys-led";
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};
	};

	/* BEEP 低电平响、高电平停（PNP 8550 驱动） */
	beep {
		compatible = "gpio-beeper";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_beep>;
		gpios = <&gpio5 1 GPIO_ACTIVE_LOW>;
	};

	/* 底板功能按键 KEY0：UART1_CTS_B / GPIO1_IO18，低有效 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_key>;

		key0 {
			label = "KEY0";
			linux,code = <KEY_ENTER>;
			gpios = <&gpio1 18 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
 * i.MX6ULL 的 OCOTP compatible 是 fsl,imx6ull-ocotp，而
 * mach-imx6ul.c 的 MAC 初始化按 fsl,imx6ul-ocotp 查找，补一个兼容项，
 * 避免 "failed to find ocotp node" 并使用 OCOTP 中的 MAC 地址。
 */
&ocotp {
	compatible = "fsl,imx6ull-ocotp", "fsl,imx6ul-ocotp", "syscon";

	/*
	 * imx6ul.dtsi 里 MAC cell 定义成 6 字节（reg = <0x8e 6>），不按
	 * OCOTP 的 4 字节 word 对齐，nvmem 层在 cell 创建时会打
	 * "cell mac-addr raw len 6 unaligned to nvmem word size 4"。
	 * 这里覆盖为 8 字节（读满两个 word），fec 驱动用
	 * of_get_mac_address() 只取前 6 字节（ETH_ALEN），语义不变。
	 *
	 * 注意：本板 OCOTP 的 MAC 区域（0x88/0x8e）实测全 0（出厂未烧录
	 * MAC），因此对齐后 fec 读到的仍是全 0，is_valid_ether_addr() 判
	 * 无效仍会回退到随机 MAC。若要稳定 MAC，另在 &fec2 加
	 * local-mac-address = [xx xx xx xx xx xx];（见下文注释）。
	 */
	fec2_mac_addr: mac-addr@8e {
		reg = <0x8e 8>;
	};
};

/*
 * busfreq 空闲会把 DDR 降到 24MHz，实测会让 LCDIF 读 framebuffer 出错，
 * 表现为启动一段时间后屏幕出现横线、画面拉伸；禁用，固定跑 400MHz。
 */
&soc {
	busfreq {
		status = "disabled";
	};
};

/* 调试串口 UART1 */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

/*
 * RS232 / RS485 / GPS：底板用跳线选择，三者都接 UART3。
 * RS485 的 DE/RE 由 RS485_RX 硬件自动控制，无需方向 GPIO。
 */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	status = "okay";
};

/* CAN1：TJA1050，FLEXCAN1（UART3_RTS_B/CTS_B 引脚） */
&can1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	status = "okay";
};

/*
 * I2C2（核心板 B31/B32 = UART5_TXD/RXD，底板 R40/R41 4.7K 上拉）。
 * 总线上挂两个设备：4.3 寸 LCD 的电容触摸 IC、P1 摄像头接口的 OV5640。
 * 两者地址不冲突（触摸 0x14/0x5D，摄像头 0x3C）。
 */
&i2c2 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2>;
	status = "okay";

	/*
	 * 4.3 寸 800x480 电容触摸屏（正点原子屏 ID 0x04，GT9xx 系列）：
	 *   LCD 接口 pin39 CT_INT → GPIO1_IO09，10K 上拉，低有效
	 *   LCD 接口 pin35 CT_RST → SNVS_TAMPER9 / GPIO5_IO09，10K 上拉
	 *   LCD 接口 pin38/36    → I2C2_SCL / I2C2_SDA
	 *   电源                 → 底板 DCDC_3V3（always-on）
	 *
	 * 实机 probe 日志：Goodix-TS 1-0014: ID 9147, version: 1040
	 *   → 触控 IC 确认为 GT9147，I2C 地址 0x14，与下面声明一致。
	 *
	 * mainline goodix 驱动在 probe 时会按本节点的 reg 主动把芯片
	 * 配置成该地址（复位时序中拉高/拉低 INT 选择 0x14 或 0x5D），
	 * 因此这里写 0x14 即可；若 probe 报 ENXIO 再改 <0x5d>。
	 *
	 * 注意：早期把 irq-gpios/reset-gpios 写成 ACTIVE_LOW 时，复位序列
	 * 物理电平整体反相，芯片没被正确初始化，config 区读回全 0，
	 * 驱动打印 "Invalid config (799, 479, 0), using defaults" 并把
	 * 下面的 800x480 覆盖成 4096x4096。改成 ACTIVE_HIGH 后 config
	 * 读取正常、告警消失，实测 ABS X/Y = 799/479。驱动未做任何修改。
	 */
	gt9xx: touchscreen@14 {
		compatible = "goodix,gt9147";
		reg = <0x14>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tsc_int &pinctrl_tsc_reset>;
		interrupt-parent = <&gpio1>;
		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
		/*
		 * 极性必须 ACTIVE_HIGH：goodix.c 用的是 gpiod_direction_output()
		 * 的逻辑值，复位序列为 output(rst,0) → 20ms → 选地址 →
		 * output(rst,1)。ACTIVE_HIGH 时逻辑 0 = 物理低（复位）、逻辑 1
		 * = 物理高（释放），与 CT_RST 低有效一致；写成 ACTIVE_LOW 会
		 * 整体反相（先高后低），芯片可能停在复位态或地址选择错误。
		 * 同理地址选择 output(int, addr==0x14) 传逻辑 1，需为物理高，
		 * 即"复位释放后 5ms 内 INT 高 → I2C 地址 0x14"。
		 * 树内 imx6q-kp / imx6ul-kontron-bl-43 / sun7i-a20-wexler 等
		 * mainline 板子也都是 GPIO_ACTIVE_HIGH。
		 */
		irq-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio5 9 GPIO_ACTIVE_HIGH>;
		AVDD28-supply = <&reg_touch_3v3>;
		VDDIO-supply = <&reg_touch_3v3>;
		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;
		status = "okay";
	};

	/*
	 * 摄像头模块接口（OV5640，并行 DVP 8-bit，P1 = Header 9X2）：
	 *   - I2C 控制：I2C2，地址 0x3C
	 *   - 数据：CSI 并行总线，PIXCLK/HSYNC/VSYNC + D0..D7
	 *   - 主时钟：CSI_MCLK（经 R32 22R 串阻，由 CSI 时钟树提供）
	 *   - PWDN = GPIO1_IO04（核心板 B14 / GPIO_4），高有效
	 *   - RESET = GPIO1_IO02（核心板 B13 / GPIO_2），低有效
	 * 注意：clock-lanes / data-lanes 是 MIPI CSI-2 属性，并行 DVP
	 * 只需要 bus-width + data-shift（D0..D7 接 CSI_DATA02..09）。
	 */
	ov5640: camera@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_csi_pwr>;
		clocks = <&clks IMX6UL_CLK_CSI>;
		clock-names = "xclk";
		powerdown-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
		/* 模组由底板 DCDC_3V3 供电，内部 LDO 再产生 2.8V/1.5V/1.8V，
		 * 三路 supply 同源（不写会拿到 dummy regulator 并打印警告） */
		AVDD-supply = <&reg_cam_3v3>;
		DVDD-supply = <&reg_cam_3v3>;
		DOVDD-supply = <&reg_cam_3v3>;
		status = "okay";

		port {
			ov5640_ep: endpoint {
				remote-endpoint = <&csi1_ep>;
				bus-type = <MEDIA_BUS_TYPE_PARALLEL>;
				bus-width = <8>;
				data-shift = <2>;
				pclk-sample = <1>;
				hsync-active = <0>;
				vsync-active = <0>;
			};
		};
	};
};

/* CSI 桥；clock-names 必须与 imx7-media-csi 驱动一致（只认 "mclk"） */
&csi {
	clocks = <&clks IMX6UL_CLK_CSI>;
	clock-names = "mclk";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_csi1>;
	status = "okay";

	port {
		csi1_ep: endpoint {
			remote-endpoint = <&ov5640_ep>;
		};
	};
};

/*
 * PXP 硬件加速（色彩空间转换 + 缩放 + 旋转），用于摄像头 YUV->RGB 与缩放。
 * 必须覆盖 compatible：SoC dtsi 里是 NXP BSP 风格的 "fsl,imx6ull-pxp-dma"，
 * 而 mainline imx-pxp 驱动只匹配 "fsl,imx6ull-pxp"。
 * clock-names 同理：驱动只取 "axi"。
 */
&pxp {
	compatible = "fsl,imx6ull-pxp";
	clocks = <&clks IMX6UL_CLK_PXP>;
	clock-names = "axi";
	status = "okay";
};

/*
 * 单网口 ENET2：RTL8201F（PHY ID 0x001cc816，MDIO 地址 1）。
 * ENET2_RST = SNVS_TAMPER8 / GPIO5_IO08，低有效，复位 200ms。
 * 注意：复位脚必须放在 iomuxc_snvs 下，不能混在 iomuxc 的 RMII 组里。
 */
&fec2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet2 &pinctrl_enet2_reset>;
	phy-mode = "rmii";
	phy-handle = <&ethphy1>;
	phy-reset-gpios = <&gpio5 8 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <200>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy1: ethernet-phy@1 {
			compatible = "ethernet-phy-id001c.c816";
			reg = <1>;
			clocks = <&clks IMX6UL_CLK_ENET2_REF>;
			clock-names = "rmii-ref";
		};
	};
};

/* GPMI NAND：分区与 U-Boot 的 NAND_PARTITION_LAYOUT 保持一致 */
&gpmi {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpmi_nand_1>;
	status = "okay";
	nand-on-flash-bbt;
	fsl,use-minimum-ecc;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "boot";
			reg = <0x00000000 0x00800000>;	/* 8MiB */
			read-only;
		};

		partition@800000 {
			label = "env";
			reg = <0x00800000 0x00400000>;	/* 4MiB */
			read-only;	/* 仅由 U-Boot saveenv 写入 */
		};

		partition@c00000 {
			label = "logo";
			reg = <0x00c00000 0x00800000>;	/* 8MiB */
		};

		partition@1400000 {
			label = "kernel";
			reg = <0x01400000 0x02000000>;	/* 32MiB */
		};

		partition@3400000 {
			label = "dtb";
			reg = <0x03400000 0x01000000>;	/* 16MiB */
		};

		partition@4400000 {
			label = "tee";
			reg = <0x04400000 0x00400000>;	/* 4MiB */
		};

		partition@4800000 {
			label = "rootfs";
			reg = <0x04800000 NAND_ROOTFS_SIZE>;	/* 440MiB */
		};
	};
};

/*
 * 4.3 寸 RGB LCD（800x480@60Hz，31MHz），时序与 U-Boot 一致。
 * LCD 的 RESET 是 LCD 接口 pin40 的 RESET 网络（核心板 A40，与整板复位
 * 按键/MCU 共用），不由任何 GPIO 控制，因此这里没有 enable-gpio。
 * LCD 接口 pin35/pin39 的 CT_RST / CT_INT 属于电容触摸屏，
 * 已在 &i2c2 的 gt9xx 节点与 pinctrl_tsc_* 中配置。
 */
&lcdif {
	assigned-clocks = <&clks IMX6UL_CLK_LCDIF_PRE_SEL>;
	assigned-clock-parents = <&clks IMX6UL_CLK_PLL5_VIDEO_DIV>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lcdif_dat &pinctrl_lcdif_ctrl>;
	display = <&display0>;
	/*
	 * LCD 模组由底板 DCDC_3V3 直连（40pin 接口 pin1/2），不可控。
	 * mxsfb 用 devm_regulator_get(dev, "lcd") 取该 supply，缺失时
	 * regulator core 会打印 "supply lcd not found, using dummy
	 * regulator"；显式给出可消除警告，语义也更准确。
	 */
	lcd-supply = <&reg_lcd_3v3>;
	status = "okay";

	display0: display@0 {
		/*
		 * 本板 4.3 寸 RGB888 屏（800x480@60Hz），屏幕手册给出的时序：
		 *   显示区 800 tCLK / 480 th，像素时钟 31MHz
		 *   HSPW 48、HBP 88、HFP 40 → H_total = 976 tCLK
		 *   VSPW  3、VBP 32、VFP 13 → V_total = 528 th
		 *   31MHz / (976 * 528) ≈ 60.1Hz
		 * 注意：hactive 必须与屏幕有效像素一致（800）。写成 840 会与
		 * U-Boot 及 logo 数据宽度不匹配（居中算出负偏移→花屏）。
		 * 32bpp RGB888 经 24bit 总线输出。
		 */
		bits-per-pixel = <32>;
		bus-width = <24>;

		display-timings {
			native-mode = <&timing0>;

			timing0: timing0 {
				clock-frequency = <31000000>;
				hactive = <800>;
				vactive = <480>;
				hfront-porch = <40>;
				hback-porch = <88>;
				hsync-len = <48>;
				vback-porch = <32>;
				vfront-porch = <13>;
				vsync-len = <3>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <0>;
			};
		};
	};
};

/* PWM1 背光（GPIO1_IO08 / PWM1_OUT） */
&pwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm1>;
	status = "okay";
};

/* TF 卡：USDHC1，4 位，CD = GPIO1_IO19 */
&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	bus-width = <4>;
	cd-gpios = <&gpio1 19 GPIO_ACTIVE_LOW>;
	no-1-8-v;
	status = "okay";
};

/* USB：OTG1 为 MiniUSB OTG 口，OTG2 为 USB HOST 口 */
&usbotg1 {
	dr_mode = "otg";
	disable-over-current;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb_otg1>;
	status = "okay";
};

&usbotg2 {
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&usbphy1 {
	fsl,tx-d-cal = <106>;
};

/* USB HOST 口走 OTG2，对应 usbphy2，阻抗校准与 usbphy1 保持一致 */
&usbphy2 {
	fsl,tx-d-cal = <106>;
};

/*
 * ON_OFF 按键（底板原理图核心板连接器 B4 = ON_OFF）。
 * i.MX6ULL 的 SNVS 域 PWRON 引脚，接在底板 K1 按键上：
 *   短按 → 唤醒/开机；长按 → 触发 SNVS power down。
 * 该功能由 snvs_pwrkey 驱动提供，dtsi 里默认 disabled，这里按原理图启用。
 * ON_OFF 是 SoC 专用引脚，不需要 pinctrl。
 */
&snvs_pwrkey {
	status = "okay";
};

&wdog1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdog>;
	fsl,ext-reset-output;
};

&iomuxc {
	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6UL_PAD_UART1_TX_DATA__UART1_DCE_TX	0x1b0b1
			MX6UL_PAD_UART1_RX_DATA__UART1_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <
			MX6UL_PAD_UART3_TX_DATA__UART3_DCE_TX	0x1b0b1
			MX6UL_PAD_UART3_RX_DATA__UART3_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_flexcan1: flexcan1grp {
		fsl,pins = <
			MX6UL_PAD_UART3_RTS_B__FLEXCAN1_RX	0x1b020
			MX6UL_PAD_UART3_CTS_B__FLEXCAN1_TX	0x1b020
		>;
	};

	pinctrl_i2c2: i2c2grp {
		fsl,pins = <
			MX6UL_PAD_UART5_TX_DATA__I2C2_SCL	0x4001b8b0
			MX6UL_PAD_UART5_RX_DATA__I2C2_SDA	0x4001b8b0
		>;
	};

	/* 触摸中断 CT_INT：LCD 接口 pin39 → GPIO1_IO09（底板 R18 10K 上拉） */
	pinctrl_tsc_int: tscintgrp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO09__GPIO1_IO09	0x10b0
		>;
	};

	pinctrl_key: keygrp {
		fsl,pins = <
			MX6UL_PAD_UART1_CTS_B__GPIO1_IO18	0xf080
		>;
	};

	pinctrl_enet2: enet2grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO07__ENET2_MDC		0x1b0b0
			MX6UL_PAD_GPIO1_IO06__ENET2_MDIO	0x1b0b0
			MX6UL_PAD_ENET2_RX_EN__ENET2_RX_EN	0x1b0b0
			MX6UL_PAD_ENET2_RX_ER__ENET2_RX_ER	0x1b0b0
			MX6UL_PAD_ENET2_RX_DATA0__ENET2_RDATA00	0x1b0b0
			MX6UL_PAD_ENET2_RX_DATA1__ENET2_RDATA01	0x1b0b0
			MX6UL_PAD_ENET2_TX_EN__ENET2_TX_EN	0x1b0b0
			MX6UL_PAD_ENET2_TX_DATA0__ENET2_TDATA00	0x1b0b0
			MX6UL_PAD_ENET2_TX_DATA1__ENET2_TDATA01	0x1b0b0
			MX6UL_PAD_ENET2_TX_CLK__ENET2_REF_CLK2	0x4001b031
		>;
	};

	pinctrl_lcdif_dat: lcdifdatgrp {
		fsl,pins = <
			MX6UL_PAD_LCD_DATA00__LCDIF_DATA00	0x79
			MX6UL_PAD_LCD_DATA01__LCDIF_DATA01	0x79
			MX6UL_PAD_LCD_DATA02__LCDIF_DATA02	0x79
			MX6UL_PAD_LCD_DATA03__LCDIF_DATA03	0x79
			MX6UL_PAD_LCD_DATA04__LCDIF_DATA04	0x79
			MX6UL_PAD_LCD_DATA05__LCDIF_DATA05	0x79
			MX6UL_PAD_LCD_DATA06__LCDIF_DATA06	0x79
			MX6UL_PAD_LCD_DATA07__LCDIF_DATA07	0x79
			MX6UL_PAD_LCD_DATA08__LCDIF_DATA08	0x79
			MX6UL_PAD_LCD_DATA09__LCDIF_DATA09	0x79
			MX6UL_PAD_LCD_DATA10__LCDIF_DATA10	0x79
			MX6UL_PAD_LCD_DATA11__LCDIF_DATA11	0x79
			MX6UL_PAD_LCD_DATA12__LCDIF_DATA12	0x79
			MX6UL_PAD_LCD_DATA13__LCDIF_DATA13	0x79
			MX6UL_PAD_LCD_DATA14__LCDIF_DATA14	0x79
			MX6UL_PAD_LCD_DATA15__LCDIF_DATA15	0x79
			MX6UL_PAD_LCD_DATA16__LCDIF_DATA16	0x79
			MX6UL_PAD_LCD_DATA17__LCDIF_DATA17	0x79
			MX6UL_PAD_LCD_DATA18__LCDIF_DATA18	0x79
			MX6UL_PAD_LCD_DATA19__LCDIF_DATA19	0x79
			MX6UL_PAD_LCD_DATA20__LCDIF_DATA20	0x79
			MX6UL_PAD_LCD_DATA21__LCDIF_DATA21	0x79
			MX6UL_PAD_LCD_DATA22__LCDIF_DATA22	0x79
			MX6UL_PAD_LCD_DATA23__LCDIF_DATA23	0x79
		>;
	};

	pinctrl_lcdif_ctrl: lcdifctrlgrp {
		fsl,pins = <
			MX6UL_PAD_LCD_CLK__LCDIF_CLK		0x79
			MX6UL_PAD_LCD_ENABLE__LCDIF_ENABLE	0x79
			MX6UL_PAD_LCD_HSYNC__LCDIF_HSYNC	0x79
			MX6UL_PAD_LCD_VSYNC__LCDIF_VSYNC	0x79
		>;
	};

	pinctrl_pwm1: pwm1grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO08__PWM1_OUT	0x110b0
		>;
	};

	/* CSI 并行总线：PIXCLK/HSYNC/VSYNC + 8-bit 数据（D2..D9 对齐） */
	pinctrl_csi1: csi1grp {
		fsl,pins = <
			MX6UL_PAD_CSI_PIXCLK__CSI_PIXCLK	0x1b088
			MX6UL_PAD_CSI_VSYNC__CSI_VSYNC		0x1b088
			MX6UL_PAD_CSI_HSYNC__CSI_HSYNC		0x1b088
			MX6UL_PAD_CSI_DATA00__CSI_DATA02	0x1b088
			MX6UL_PAD_CSI_DATA01__CSI_DATA03	0x1b088
			MX6UL_PAD_CSI_DATA02__CSI_DATA04	0x1b088
			MX6UL_PAD_CSI_DATA03__CSI_DATA05	0x1b088
			MX6UL_PAD_CSI_DATA04__CSI_DATA06	0x1b088
			MX6UL_PAD_CSI_DATA05__CSI_DATA07	0x1b088
			MX6UL_PAD_CSI_DATA06__CSI_DATA08	0x1b088
			MX6UL_PAD_CSI_DATA07__CSI_DATA09	0x1b088
		>;
	};

	/* OV5640 的 PWDN(高有效) / RESET(低有效) 控制脚 */
	pinctrl_csi_pwr: csipwrgrp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO04__GPIO1_IO04	0x10b0
			MX6UL_PAD_GPIO1_IO02__GPIO1_IO02	0x10b0
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX6UL_PAD_SD1_CMD__USDHC1_CMD		0x17059
			MX6UL_PAD_SD1_CLK__USDHC1_CLK		0x10071
			MX6UL_PAD_SD1_DATA0__USDHC1_DATA0	0x17059
			MX6UL_PAD_SD1_DATA1__USDHC1_DATA1	0x17059
			MX6UL_PAD_SD1_DATA2__USDHC1_DATA2	0x17059
			MX6UL_PAD_SD1_DATA3__USDHC1_DATA3	0x17059
			MX6UL_PAD_UART1_RTS_B__GPIO1_IO19	0x17059
		>;
	};

	pinctrl_usb_otg1: usbotg1grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO00__ANATOP_OTG1_ID	0x17059
		>;
	};

	pinctrl_wdog: wdoggrp {
		fsl,pins = <
			MX6UL_PAD_LCD_RESET__WDOG1_WDOG_ANY	0x30b0
		>;
	};

	pinctrl_led: ledgrp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO03__GPIO1_IO03	0x10b0
		>;
	};

	pinctrl_gpmi_nand_1: gpmi-nand-1 {
		fsl,pins = <
			MX6UL_PAD_NAND_CLE__RAWNAND_CLE		0xb0b1
			MX6UL_PAD_NAND_ALE__RAWNAND_ALE		0xb0b1
			MX6UL_PAD_NAND_WP_B__RAWNAND_WP_B	0xb0b1
			MX6UL_PAD_NAND_READY_B__RAWNAND_READY_B	0xb000
			MX6UL_PAD_NAND_CE0_B__RAWNAND_CE0_B	0xb0b1
			MX6UL_PAD_NAND_CE1_B__RAWNAND_CE1_B	0xb0b1
			MX6UL_PAD_NAND_RE_B__RAWNAND_RE_B	0xb0b1
			MX6UL_PAD_NAND_WE_B__RAWNAND_WE_B	0xb0b1
			MX6UL_PAD_NAND_DATA00__RAWNAND_DATA00	0xb0b1
			MX6UL_PAD_NAND_DATA01__RAWNAND_DATA01	0xb0b1
			MX6UL_PAD_NAND_DATA02__RAWNAND_DATA02	0xb0b1
			MX6UL_PAD_NAND_DATA03__RAWNAND_DATA03	0xb0b1
			MX6UL_PAD_NAND_DATA04__RAWNAND_DATA04	0xb0b1
			MX6UL_PAD_NAND_DATA05__RAWNAND_DATA05	0xb0b1
			MX6UL_PAD_NAND_DATA06__RAWNAND_DATA06	0xb0b1
			MX6UL_PAD_NAND_DATA07__RAWNAND_DATA07	0xb0b1
		>;
	};
};

&iomuxc_snvs {
	/*
	 * 触摸复位 CT_RST：LCD 接口 pin35 → SNVS_TAMPER9 / GPIO5_IO09
	 * （底板 R19 10K 上拉）。注意该 pad 属于 iomuxc_snvs 域，
	 * 不能和 GPIO1_IO09 放在同一个 iomuxc 组里。
	 */
	pinctrl_tsc_reset: tscresetgrp {
		fsl,pins = <
			MX6ULL_PAD_SNVS_TAMPER9__GPIO5_IO09	0x10b0
		>;
	};

	/* ENET2 PHY 复位：SNVS_TAMPER8 / GPIO5_IO08，低有效 */
	pinctrl_enet2_reset: enet2resetgrp {
		fsl,pins = <
			MX6ULL_PAD_SNVS_TAMPER8__GPIO5_IO08	0x10b0
		>;
	};

	pinctrl_beep: beepgrp {
		fsl,pins = <
			MX6ULL_PAD_SNVS_TAMPER1__GPIO5_IO01	0x10b0
		>;
	};
};
