// SPDX-License-Identifier: (GPL-2.0 OR MIT)
//
// i.MX6ULL Mini (NAND) 板级设备树
//
// 不再继承 NXP EVK 的 imx6ul-14x14-evk.dtsi，只描述本板实际存在的硬件：
//   - DDR3L 256MiB
//   - 4.3 寸 RGB888 LCD（31MHz 像素时钟，840x480 时序，约 57.8Hz），
//     PWM1 背光（GPIO1_IO08），GPIO5_IO09(SNVS_TAMPER9) 复位
//   - 单网口 ENET2，RTL8201F PHY（MDIO 地址 1，GPIO5_IO08 复位）
//   - GPMI NAND 512MiB，分区与 U-Boot 的 NAND_PARTITION_LAYOUT 一致
//   - TF 卡（USDHC1，CD = GPIO1_IO19）
//   - USB OTG（OTG1，MiniUSB）+ USB HOST（OTG2）+ USB 串口（调试）
//   - 红色状态 LED（GPIO1_IO03，低有效）、有源蜂鸣器（GPIO5_IO01）
//
// 已启用（2026-11-10）：OV5640 摄像头（CSI 并行 DVP，见文件中部节点）、
//   PXP 硬件色彩转换/缩放。
// 明确不包含（本板没有或暂未启用）：
//   WM8960 音频（板载无 codec，音频改走 USB 声卡）、AP3216C/ICM20608、
//   SDIO WiFi、QSPI、USDHC2、74HC595 GPIO 扩展、触摸屏。
//
// 生成的 dtb 名为 imx6ull-14x14-evk_nand.dtb，与 U-Boot 的
// dtb_file / tftp_update 下载文件名一致。

/dts-v1/;

#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/media/video-interfaces.h>
#include "imx6ull.dtsi"

#define NAND_ROOTFS_SIZE 0x1b800000	/* 440MiB = 512MiB - 72MiB 前置分区 */

/ {
	model = "i.MX6ULL Mini NAND Board";
	compatible = "fsl,imx6ull-14x14-evk", "fsl,imx6ull";

	aliases {
		ethernet0 = &fec2;
		mmc0 = &usdhc1;
	};

	chosen {
		stdout-path = &uart1;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;	/* 256MiB */
	};

	/*
	 * 背光（PWM1，周期 5ms = 200Hz）。
	 *
	 * brightness-levels 的值本身就是占空比（scale = 最后一项 = 255），
	 * default-brightness-level 是数组下标。原来的
	 * <0 4 8 16 32 64 128 255> 只有 8 档，50% 之后直接跳到 100%，
	 * 中间没有可调空间。这里改为两点 + num-interpolated-steps 线性插值：
	 *   生成 (2-1)*255+1 = 256 档，max_brightness = 255
	 *   于是 brightness(0..255) 直接等于占空比百分比 * 2.55
	 * 默认 204 = 255*80% ≈ 80% 占空比，与 U-Boot 的 PWM 占空比保持一致。
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm1 0 5000000 0>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <204>;
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_led>;

		led0 {
			label = "sys-led";
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};
	};

	/* BEEP 低电平响、高电平停（PNP 8550 驱动） */
	beep {
		compatible = "gpio-beeper";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_beep>;
		gpios = <&gpio5 1 GPIO_ACTIVE_LOW>;
	};

	/* 底板功能按键 KEY0：UART1_CTS_B / GPIO1_IO18，低有效 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_key>;

		key0 {
			label = "KEY0";
			linux,code = <KEY_ENTER>;
			gpios = <&gpio1 18 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
 * i.MX6ULL 的 OCOTP compatible 是 fsl,imx6ull-ocotp，而
 * mach-imx6ul.c 的 MAC 初始化按 fsl,imx6ul-ocotp 查找，补一个兼容项，
 * 避免 "failed to find ocotp node" 并使用 OCOTP 中的 MAC 地址。
 */
&ocotp {
	compatible = "fsl,imx6ull-ocotp", "fsl,imx6ul-ocotp", "syscon";
};

/*
 * busfreq 空闲会把 DDR 降到 24MHz，实测会让 LCDIF 读 framebuffer 出错，
 * 表现为启动一段时间后屏幕出现横线、画面拉伸；禁用，固定跑 400MHz。
 */
&soc {
	busfreq {
		status = "disabled";
	};
};

/* 调试串口 UART1 */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

/*
 * RS232 / RS485 / GPS：底板用跳线选择，三者都接 UART3。
 * RS485 的 DE/RE 由 RS485_RX 硬件自动控制，无需方向 GPIO。
 */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	status = "okay";
};

/* CAN1：TJA1050，FLEXCAN1（UART3_RTS_B/CTS_B 引脚） */
&can1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	status = "okay";
};

/* ATK 模块接口（MPU6050/手势等）与摄像头模块共用 I2C2 */
&i2c2 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2>;
	status = "okay";
};

/*
 * 摄像头模块接口（OV5640，并行 DVP 8-bit）：
 *   - I2C 控制：I2C2，地址 0x3C
 *   - 数据：CSI 并行总线，PIXCLK/HSYNC/VSYNC + DATA00..07
 *   - 主时钟：CSI_MCLK = 24MHz（由 CSI 时钟树提供）
 *   - PWDN = GPIO1_IO04（高有效），RESET = GPIO1_IO02（低有效）
 * 若实际板子的 PWDN/RESET 引脚与此不同，改 pinctrl_csi_pwr 与
 * ov5640 节点的 powerdown-gpios/reset-gpios 即可。
 * SDIO WiFi 使用 USDHC2，与 NAND 引脚复用，NAND 启动时不可用。
 */
&i2c2 {
	ov5640: camera@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_csi_pwr>;
		clocks = <&clks IMX6UL_CLK_CSI>;
		clock-names = "xclk";
		powerdown-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
		status = "okay";

		port {
			ov5640_ep: endpoint {
				remote-endpoint = <&csi1_ep>;
				bus-type = <MEDIA_BUS_TYPE_PARALLEL>;
				bus-width = <8>;
				data-shift = <2>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
				pclk-sample = <1>;
				hsync-active = <0>;
				vsync-active = <0>;
			};
		};
	};
};

/* CSI 桥；clock-names 必须与 imx7-media-csi 驱动一致（只认 "mclk"） */
&csi {
	clocks = <&clks IMX6UL_CLK_CSI>;
	clock-names = "mclk";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_csi1>;
	status = "okay";

	port {
		csi1_ep: endpoint {
			remote-endpoint = <&ov5640_ep>;
		};
	};
};

/*
 * PXP 硬件加速（色彩空间转换 + 缩放 + 旋转），用于摄像头 YUV->RGB 与缩放。
 * 必须覆盖 compatible：SoC dtsi 里是 NXP BSP 风格的 "fsl,imx6ull-pxp-dma"，
 * 而 mainline imx-pxp 驱动只匹配 "fsl,imx6ull-pxp"。
 * clock-names 同理：驱动只取 "axi"。
 */
&pxp {
	compatible = "fsl,imx6ull-pxp";
	clocks = <&clks IMX6UL_CLK_PXP>;
	clock-names = "axi";
	status = "okay";
};

/*
 * 单网口 ENET2：RTL8201F（PHY ID 0x001cc816，MDIO 地址 1）。
 * ENET2_RST = SNVS_TAMPER8 / GPIO5_IO08，低有效，复位 200ms。
 * 注意：复位脚必须放在 iomuxc_snvs 下，不能混在 iomuxc 的 RMII 组里。
 */
&fec2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet2 &pinctrl_enet2_reset>;
	phy-mode = "rmii";
	phy-handle = <&ethphy1>;
	phy-reset-gpios = <&gpio5 8 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <200>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy1: ethernet-phy@1 {
			compatible = "ethernet-phy-id001c.c816";
			reg = <1>;
			clocks = <&clks IMX6UL_CLK_ENET2_REF>;
			clock-names = "rmii-ref";
		};
	};
};

/* GPMI NAND：分区与 U-Boot 的 NAND_PARTITION_LAYOUT 保持一致 */
&gpmi {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpmi_nand_1>;
	status = "okay";
	nand-on-flash-bbt;
	fsl,use-minimum-ecc;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "boot";
			reg = <0x00000000 0x00800000>;	/* 8MiB */
			read-only;
		};

		partition@800000 {
			label = "env";
			reg = <0x00800000 0x00400000>;	/* 4MiB */
			read-only;	/* 仅由 U-Boot saveenv 写入 */
		};

		partition@c00000 {
			label = "logo";
			reg = <0x00c00000 0x00800000>;	/* 8MiB */
		};

		partition@1400000 {
			label = "kernel";
			reg = <0x01400000 0x02000000>;	/* 32MiB */
		};

		partition@3400000 {
			label = "dtb";
			reg = <0x03400000 0x01000000>;	/* 16MiB */
		};

		partition@4400000 {
			label = "tee";
			reg = <0x04400000 0x00400000>;	/* 4MiB */
		};

		partition@4800000 {
			label = "rootfs";
			reg = <0x04800000 NAND_ROOTFS_SIZE>;	/* 440MiB */
		};
	};
};

/* 7 寸 RGB LCD：时序与 U-Boot 实机 840x480 输出一致 */
&lcdif {
	assigned-clocks = <&clks IMX6UL_CLK_LCDIF_PRE_SEL>;
	assigned-clock-parents = <&clks IMX6UL_CLK_PLL5_VIDEO_DIV>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lcdif_dat &pinctrl_lcdif_ctrl
		     &pinctrl_lcdif_reset>;
	display = <&display0>;
	enable-gpio = <&gpio5 9 GPIO_ACTIVE_HIGH>;	/* LCD 复位，与 U-Boot 一致 */
	status = "okay";

	display0: display@0 {
		/*
		 * 本板 4.3 寸 RGB888 屏（800x480@60Hz），屏幕手册给出的时序：
		 *   显示区 800 tCLK / 480 th，像素时钟 31MHz
		 *   HSPW 48、HBP 88、HFP 40 → H_total = 976 tCLK
		 *   VSPW  3、VBP 32、VFP 13 → V_total = 528 th
		 *   31MHz / (976 * 528) ≈ 60.1Hz
		 * 注意：hactive 必须与屏幕有效像素一致（800）。写成 840 会与
		 * U-Boot 及 logo 数据宽度不匹配（居中算出负偏移→花屏）。
		 * 32bpp RGB888 经 24bit 总线输出。
		 */
		bits-per-pixel = <32>;
		bus-width = <24>;

		display-timings {
			native-mode = <&timing0>;

			timing0: timing0 {
				clock-frequency = <31000000>;
				hactive = <800>;
				vactive = <480>;
				hfront-porch = <40>;
				hback-porch = <88>;
				hsync-len = <48>;
				vback-porch = <32>;
				vfront-porch = <13>;
				vsync-len = <3>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <0>;
			};
		};
	};
};

/* PWM1 背光（GPIO1_IO08 / PWM1_OUT） */
&pwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm1>;
	status = "okay";
};

/* TF 卡：USDHC1，4 位，CD = GPIO1_IO19 */
&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	bus-width = <4>;
	cd-gpios = <&gpio1 19 GPIO_ACTIVE_LOW>;
	no-1-8-v;
	status = "okay";
};

/* USB：OTG1 为 MiniUSB OTG 口，OTG2 为 USB HOST 口 */
&usbotg1 {
	dr_mode = "otg";
	disable-over-current;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb_otg1>;
	status = "okay";
};

&usbotg2 {
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&usbphy1 {
	fsl,tx-d-cal = <106>;
};

&wdog1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdog>;
	fsl,ext-reset-output;
};

&iomuxc {
	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6UL_PAD_UART1_TX_DATA__UART1_DCE_TX	0x1b0b1
			MX6UL_PAD_UART1_RX_DATA__UART1_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <
			MX6UL_PAD_UART3_TX_DATA__UART3_DCE_TX	0x1b0b1
			MX6UL_PAD_UART3_RX_DATA__UART3_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_flexcan1: flexcan1grp {
		fsl,pins = <
			MX6UL_PAD_UART3_RTS_B__FLEXCAN1_RX	0x1b020
			MX6UL_PAD_UART3_CTS_B__FLEXCAN1_TX	0x1b020
		>;
	};

	pinctrl_i2c2: i2c2grp {
		fsl,pins = <
			MX6UL_PAD_UART5_TX_DATA__I2C2_SCL	0x4001b8b0
			MX6UL_PAD_UART5_RX_DATA__I2C2_SDA	0x4001b8b0
		>;
	};

	pinctrl_key: keygrp {
		fsl,pins = <
			MX6UL_PAD_UART1_CTS_B__GPIO1_IO18	0xf080
		>;
	};

	pinctrl_enet2: enet2grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO07__ENET2_MDC		0x1b0b0
			MX6UL_PAD_GPIO1_IO06__ENET2_MDIO	0x1b0b0
			MX6UL_PAD_ENET2_RX_EN__ENET2_RX_EN	0x1b0b0
			MX6UL_PAD_ENET2_RX_ER__ENET2_RX_ER	0x1b0b0
			MX6UL_PAD_ENET2_RX_DATA0__ENET2_RDATA00	0x1b0b0
			MX6UL_PAD_ENET2_RX_DATA1__ENET2_RDATA01	0x1b0b0
			MX6UL_PAD_ENET2_TX_EN__ENET2_TX_EN	0x1b0b0
			MX6UL_PAD_ENET2_TX_DATA0__ENET2_TDATA00	0x1b0b0
			MX6UL_PAD_ENET2_TX_DATA1__ENET2_TDATA01	0x1b0b0
			MX6UL_PAD_ENET2_TX_CLK__ENET2_REF_CLK2	0x4001b031
		>;
	};

	pinctrl_lcdif_dat: lcdifdatgrp {
		fsl,pins = <
			MX6UL_PAD_LCD_DATA00__LCDIF_DATA00	0x79
			MX6UL_PAD_LCD_DATA01__LCDIF_DATA01	0x79
			MX6UL_PAD_LCD_DATA02__LCDIF_DATA02	0x79
			MX6UL_PAD_LCD_DATA03__LCDIF_DATA03	0x79
			MX6UL_PAD_LCD_DATA04__LCDIF_DATA04	0x79
			MX6UL_PAD_LCD_DATA05__LCDIF_DATA05	0x79
			MX6UL_PAD_LCD_DATA06__LCDIF_DATA06	0x79
			MX6UL_PAD_LCD_DATA07__LCDIF_DATA07	0x79
			MX6UL_PAD_LCD_DATA08__LCDIF_DATA08	0x79
			MX6UL_PAD_LCD_DATA09__LCDIF_DATA09	0x79
			MX6UL_PAD_LCD_DATA10__LCDIF_DATA10	0x79
			MX6UL_PAD_LCD_DATA11__LCDIF_DATA11	0x79
			MX6UL_PAD_LCD_DATA12__LCDIF_DATA12	0x79
			MX6UL_PAD_LCD_DATA13__LCDIF_DATA13	0x79
			MX6UL_PAD_LCD_DATA14__LCDIF_DATA14	0x79
			MX6UL_PAD_LCD_DATA15__LCDIF_DATA15	0x79
			MX6UL_PAD_LCD_DATA16__LCDIF_DATA16	0x79
			MX6UL_PAD_LCD_DATA17__LCDIF_DATA17	0x79
			MX6UL_PAD_LCD_DATA18__LCDIF_DATA18	0x79
			MX6UL_PAD_LCD_DATA19__LCDIF_DATA19	0x79
			MX6UL_PAD_LCD_DATA20__LCDIF_DATA20	0x79
			MX6UL_PAD_LCD_DATA21__LCDIF_DATA21	0x79
			MX6UL_PAD_LCD_DATA22__LCDIF_DATA22	0x79
			MX6UL_PAD_LCD_DATA23__LCDIF_DATA23	0x79
		>;
	};

	pinctrl_lcdif_ctrl: lcdifctrlgrp {
		fsl,pins = <
			MX6UL_PAD_LCD_CLK__LCDIF_CLK		0x79
			MX6UL_PAD_LCD_ENABLE__LCDIF_ENABLE	0x79
			MX6UL_PAD_LCD_HSYNC__LCDIF_HSYNC	0x79
			MX6UL_PAD_LCD_VSYNC__LCDIF_VSYNC	0x79
		>;
	};

	pinctrl_pwm1: pwm1grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO08__PWM1_OUT	0x110b0
		>;
	};

	/* CSI 并行总线：PIXCLK/HSYNC/VSYNC + 8-bit 数据（D2..D9 对齐） */
	pinctrl_csi1: csi1grp {
		fsl,pins = <
			MX6UL_PAD_CSI_PIXCLK__CSI_PIXCLK	0x1b088
			MX6UL_PAD_CSI_VSYNC__CSI_VSYNC		0x1b088
			MX6UL_PAD_CSI_HSYNC__CSI_HSYNC		0x1b088
			MX6UL_PAD_CSI_DATA00__CSI_DATA02	0x1b088
			MX6UL_PAD_CSI_DATA01__CSI_DATA03	0x1b088
			MX6UL_PAD_CSI_DATA02__CSI_DATA04	0x1b088
			MX6UL_PAD_CSI_DATA03__CSI_DATA05	0x1b088
			MX6UL_PAD_CSI_DATA04__CSI_DATA06	0x1b088
			MX6UL_PAD_CSI_DATA05__CSI_DATA07	0x1b088
			MX6UL_PAD_CSI_DATA06__CSI_DATA08	0x1b088
			MX6UL_PAD_CSI_DATA07__CSI_DATA09	0x1b088
		>;
	};

	/* OV5640 的 PWDN(高有效) / RESET(低有效) 控制脚 */
	pinctrl_csi_pwr: csipwrgrp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO04__GPIO1_IO04	0x10b0
			MX6UL_PAD_GPIO1_IO02__GPIO1_IO02	0x10b0
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX6UL_PAD_SD1_CMD__USDHC1_CMD		0x17059
			MX6UL_PAD_SD1_CLK__USDHC1_CLK		0x10071
			MX6UL_PAD_SD1_DATA0__USDHC1_DATA0	0x17059
			MX6UL_PAD_SD1_DATA1__USDHC1_DATA1	0x17059
			MX6UL_PAD_SD1_DATA2__USDHC1_DATA2	0x17059
			MX6UL_PAD_SD1_DATA3__USDHC1_DATA3	0x17059
			MX6UL_PAD_UART1_RTS_B__GPIO1_IO19	0x17059
		>;
	};

	pinctrl_usb_otg1: usbotg1grp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO00__ANATOP_OTG1_ID	0x17059
		>;
	};

	pinctrl_wdog: wdoggrp {
		fsl,pins = <
			MX6UL_PAD_LCD_RESET__WDOG1_WDOG_ANY	0x30b0
		>;
	};

	pinctrl_led: ledgrp {
		fsl,pins = <
			MX6UL_PAD_GPIO1_IO03__GPIO1_IO03	0x10b0
		>;
	};

	pinctrl_gpmi_nand_1: gpmi-nand-1 {
		fsl,pins = <
			MX6UL_PAD_NAND_CLE__RAWNAND_CLE		0xb0b1
			MX6UL_PAD_NAND_ALE__RAWNAND_ALE		0xb0b1
			MX6UL_PAD_NAND_WP_B__RAWNAND_WP_B	0xb0b1
			MX6UL_PAD_NAND_READY_B__RAWNAND_READY_B	0xb000
			MX6UL_PAD_NAND_CE0_B__RAWNAND_CE0_B	0xb0b1
			MX6UL_PAD_NAND_CE1_B__RAWNAND_CE1_B	0xb0b1
			MX6UL_PAD_NAND_RE_B__RAWNAND_RE_B	0xb0b1
			MX6UL_PAD_NAND_WE_B__RAWNAND_WE_B	0xb0b1
			MX6UL_PAD_NAND_DATA00__RAWNAND_DATA00	0xb0b1
			MX6UL_PAD_NAND_DATA01__RAWNAND_DATA01	0xb0b1
			MX6UL_PAD_NAND_DATA02__RAWNAND_DATA02	0xb0b1
			MX6UL_PAD_NAND_DATA03__RAWNAND_DATA03	0xb0b1
			MX6UL_PAD_NAND_DATA04__RAWNAND_DATA04	0xb0b1
			MX6UL_PAD_NAND_DATA05__RAWNAND_DATA05	0xb0b1
			MX6UL_PAD_NAND_DATA06__RAWNAND_DATA06	0xb0b1
			MX6UL_PAD_NAND_DATA07__RAWNAND_DATA07	0xb0b1
		>;
	};
};

&iomuxc_snvs {
	pinctrl_lcdif_reset: lcdifresetgrp {
		fsl,pins = <
			MX6ULL_PAD_SNVS_TAMPER9__GPIO5_IO09	0x79
		>;
	};

	pinctrl_enet2_reset: enet2resetgrp {
		fsl,pins = <
			MX6ULL_PAD_SNVS_TAMPER8__GPIO5_IO08	0x10b0
		>;
	};

	pinctrl_beep: beepgrp {
		fsl,pins = <
			MX6ULL_PAD_SNVS_TAMPER1__GPIO5_IO01	0x10b0
		>;
	};
};
